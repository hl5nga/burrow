#!/usr/bin/env python3
"""Drive a running debug build of Burrow and capture its window.

  scripts/devctl sessions
  scripts/devctl type <id> <text>      # \\r \\n \\e \\t and \\xNN escapes are decoded
  scripts/devctl size <width> <height>
  scripts/devctl shot <out.png>
  scripts/devctl js <code>             # run JavaScript in the webview (DOM-level UI tests)
  scripts/devctl key <key> [meta]      # dispatch a keydown to the focused element
  scripts/devctl screen [lines]        # print the active terminal's last lines (dev builds)
  scripts/devctl quit                 # graceful app exit (same path as Cmd+Q)
"""

import json
import os
import socket
import subprocess
import sys
import tempfile

SOCK = os.path.join(tempfile.gettempdir(), "burrow-dev.sock")

WINDOW_ID_SWIFT = """
import CoreGraphics
let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as! [[String: Any]]
for w in list where (w[kCGWindowOwnerName as String] as? String) == "burrow" {
  print(w[kCGWindowNumber as String]!)
  break
}
"""


def request(payload):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(SOCK)
        s.sendall((json.dumps(payload) + "\n").encode())
        reply = s.makefile().readline()
    data = json.loads(reply)
    if "error" in data:
        sys.exit(f"devctl: {data['error']}")
    return data["ok"]


def decode(text):
    # Round-trip through latin-1 so escapes are decoded but UTF-8 text survives.
    text = text.replace("\\e", "\\x1b")
    return text.encode("utf-8").decode("unicode_escape").encode("latin-1").decode("utf-8")


def window_id():
    out = subprocess.run(
        ["swift", "-"], input=WINDOW_ID_SWIFT, capture_output=True, text=True, check=True
    ).stdout.strip()
    if not out:
        sys.exit("devctl: burrow window not found")
    return out


def main(argv):
    if not argv:
        sys.exit(__doc__)
    cmd, args = argv[0], argv[1:]
    if cmd == "sessions":
        print(request({"cmd": "sessions"}))
    elif cmd == "type":
        request({"cmd": "write", "id": int(args[0]), "data": decode(" ".join(args[1:]))})
    elif cmd == "size":
        request({"cmd": "window_size", "width": float(args[0]), "height": float(args[1])})
    elif cmd == "js":
        # A block scope keeps `const` from leaking into the page's global lexical
        # scope, where a second run would fail with a redeclaration error.
        request({"cmd": "eval", "js": "{" + " ".join(args) + "\n}"})
    elif cmd == "key":
        key = args[0]
        meta = "true" if "meta" in args[1:] else "false"
        code = f"Key{key.upper()}" if len(key) == 1 and key.isalpha() else key
        request({"cmd": "eval", "js": (
            "(document.activeElement||document.body).dispatchEvent(new KeyboardEvent('keydown',"
            f"{{key:{json.dumps(key)},code:{json.dumps(code)},metaKey:{meta},bubbles:true,cancelable:true}}))"
        )})
    elif cmd == "screen":
        n = int(args[0]) if args else 20
        marker = f"SCREEN-{os.getpid()}"
        log = os.path.join(tempfile.gettempdir(), "burrow-dev-events.log")
        request({"cmd": "eval", "js": (
            "{const t=window.__burrow.tabs.activeSession().term; const b=t.buffer.active;"
            " const end=b.baseY+b.cursorY; const out=[];"
            f" for(let y=Math.max(0,end-{n}+1); y<=end; y++) out.push(b.getLine(y)?.translateToString(true)??'');"
            f" window.__TAURI__.core.invoke('dev_log',{{line:'{marker} '+JSON.stringify(out)}});}}"
        )})
        import time
        for _ in range(20):
            time.sleep(0.1)
            with open(log, encoding="utf-8") as f:
                hits = [l for l in f if l.startswith(marker)]
            if hits:
                print("\n".join(json.loads(hits[-1][len(marker) + 1:])))
                break
    elif cmd == "quit":
        request({"cmd": "quit"})
    elif cmd == "shot":
        subprocess.run(["screencapture", "-x", "-o", f"-l{window_id()}", args[0]], check=True)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
