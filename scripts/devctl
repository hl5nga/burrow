#!/usr/bin/env python3
"""Drive a running debug build of Burrow and capture its window.

  scripts/devctl sessions
  scripts/devctl type <id> <text>      # \\r \\n \\e \\t and \\xNN escapes are decoded
  scripts/devctl size <width> <height>
  scripts/devctl shot <out.png>
  scripts/devctl quit                 # graceful app exit (same path as Cmd+Q)
"""

import json
import os
import socket
import subprocess
import sys
import tempfile

SOCK = os.path.join(tempfile.gettempdir(), "burrow-dev.sock")

WINDOW_ID_SWIFT = """
import CoreGraphics
let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as! [[String: Any]]
for w in list where (w[kCGWindowOwnerName as String] as? String) == "burrow" {
  print(w[kCGWindowNumber as String]!)
  break
}
"""


def request(payload):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(SOCK)
        s.sendall((json.dumps(payload) + "\n").encode())
        reply = s.makefile().readline()
    data = json.loads(reply)
    if "error" in data:
        sys.exit(f"devctl: {data['error']}")
    return data["ok"]


def decode(text):
    # Round-trip through latin-1 so escapes are decoded but UTF-8 text survives.
    return text.encode("utf-8").decode("unicode_escape").encode("latin-1").decode("utf-8")


def window_id():
    out = subprocess.run(
        ["swift", "-"], input=WINDOW_ID_SWIFT, capture_output=True, text=True, check=True
    ).stdout.strip()
    if not out:
        sys.exit("devctl: burrow window not found")
    return out


def main(argv):
    if not argv:
        sys.exit(__doc__)
    cmd, args = argv[0], argv[1:]
    if cmd == "sessions":
        print(request({"cmd": "sessions"}))
    elif cmd == "type":
        request({"cmd": "write", "id": int(args[0]), "data": decode(" ".join(args[1:]))})
    elif cmd == "size":
        request({"cmd": "window_size", "width": float(args[0]), "height": float(args[1])})
    elif cmd == "quit":
        request({"cmd": "quit"})
    elif cmd == "shot":
        subprocess.run(["screencapture", "-x", "-o", f"-l{window_id()}", args[0]], check=True)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
