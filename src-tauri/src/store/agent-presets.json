    "working": ["esc to interrupt", "^[✻✽✢✶✳·*] \\S.*…"],
    "error": ["API Error", "^\\s*⎿\\s+Error:"],
    "idle": ["\\? for shortcuts", "^[✻✽✢✶✳·*] .+ · done", "shift\\+tab to cycle"]
  },
  "codex": {
    "label": "Codex",
    "commands": ["codex"],
    "detect": ["OpenAI Codex"],
